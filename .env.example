CLIENT_TOKEN=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
MODEL_PROFILE=balanced

# Runtime loop: max tool calls allowed in one answer cycle.
RUNTIME_LOOP_MAX_TOOL_CALLS=7
# Runtime loop: max planning/execution passes before stopping.
RUNTIME_LOOP_MAX_RESEARCH_PASSES=5
# Runtime loop: max identical tool+args signature repeats before blocking.
RUNTIME_LOOP_MAX_REPEATED_CALL_SIGNATURE=1
# Runtime loop: total latency budget in milliseconds for one answer.
RUNTIME_LOOP_MAX_LATENCY_BUDGET_MS=45000
# Runtime context carry-over: max prior turns loaded into planning context.
RUNTIME_CONTEXT_MAX_PRIOR_TURNS=5
# Runtime context carry-over: max recent channel messages loaded into context.
RUNTIME_CONTEXT_MAX_CHANNEL_MESSAGES=25
# Runtime context carry-over: max prior tool runs loaded for state reconstruction.
RUNTIME_CONTEXT_MAX_TOOL_RUNS=12
# Runtime context carry-over: max reconstructed evidence items retained.
RUNTIME_CONTEXT_MAX_CARRIED_EVIDENCE_ITEMS=32
# Debug UI: max evidence items shown in debug context preview.
DEBUG_CONTEXT_PREVIEW_MAX_EVIDENCE_ITEMS=10
# Tool resolve_channel_targets: max metadata evidence items emitted per run.
TOOL_RESOLVE_CHANNEL_TARGETS_MAX_EVIDENCE_ITEMS=6
# Tool retrieve_messages: max history evidence rows converted per run.
TOOL_RETRIEVE_MESSAGES_MAX_HISTORY_EVIDENCE_ITEMS=50
# Tool retrieve_messages: max semantic evidence rows converted per run.
TOOL_RETRIEVE_MESSAGES_MAX_SEMANTIC_EVIDENCE_ITEMS=30
# Tool retrieve_messages: max chars retained per evidence message snippet.
TOOL_RETRIEVE_MESSAGES_MAX_EVIDENCE_CONTENT_CHARS=1000
# Tool retrieve_messages: max messages crawled interactively per channel.
TOOL_RETRIEVE_MESSAGES_MAX_INTERACTIVE_CRAWL_MESSAGES=400
# Tool retrieve_messages: max messages fetched per escalation crawl call.
TOOL_RETRIEVE_MESSAGES_MAX_ESCALATION_FETCH_MESSAGES=400
# Tool retrieve_messages: default retrieval limit when no explicit limit is provided.
TOOL_RETRIEVE_MESSAGES_DEFAULT_LIMIT=100
# Tool retrieve_messages: around-message context window size.
TOOL_RETRIEVE_MESSAGES_AROUND_CONTEXT_WINDOW=15

