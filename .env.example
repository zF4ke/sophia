# Sophia environment configuration.
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.

# Required: your Discord bot token (Discord Developer Portal > your app > Bot).
DISCORD_TOKEN=

# Required: your OpenRouter API key (https://openrouter.ai/keys).
# You bring your own key — Sophia never ships one, and you pay OpenRouter directly.
OPENROUTER_API_KEY=

# Optional: comma-separated Discord user IDs granted permanent super-admin
# access on startup (cannot be removed via /access). Leave empty and configure
# admins at runtime with the /access command instead.
# Example: BOOTSTRAP_ADMIN_IDS=123456789012345678,234567890123456789
BOOTSTRAP_ADMIN_IDS=

# Optional: redirect all mutable storage (settings, runtime DBs, indexes) to a
# custom directory. Defaults to ./storage when unset.
SOPHIA_STORAGE_ROOT=
# OpenCode Zen (free models via opencode.ai/docs/zen)
OPENCODE_API_KEY=
