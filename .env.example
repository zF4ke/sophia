# Sophia environment configuration.
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.

# Required: your Discord bot token (Discord Developer Portal > your app > Bot).
DISCORD_TOKEN=

# Required for OpenRouter models and embeddings (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Bootstrap operator IDs. Configure at least one on a fresh installation so
# you can use /access. These operators cannot be removed through /access.
# Example: BOOTSTRAP_ADMIN_IDS=123456789012345678,234567890123456789
BOOTSTRAP_ADMIN_IDS=

# Optional: redirect all mutable storage (settings, runtime DBs, indexes) to a
# custom directory. Defaults to ./storage when unset.
SOPHIA_STORAGE_ROOT=
# Required for the Muse Spark 1.3 Free default through OpenCode Zen.
# Obtain your own key at opencode.ai. Free availability is provider-controlled.
OPENCODE_API_KEY=

# Recommended for web search: Serper (https://serper.dev).
SERPER_API_KEY=
# Optional alternative when Serper is not configured.
BRAVE_SEARCH_API_KEY=
