{
  "name": "sophia",
  "version": "5.0.0",
  "main": "index.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "nodemon --watch \"src/**/*\" --watch \"resources/**/*\" --ext ts,js,json,md --exec \"tsx src/index.ts\"",
    "start": "tsx ./src/index.ts",
    "check": "npm run typecheck && npm run test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:live": "vitest run -c vitest.live.config.ts",
    "test:all": "npm run test && npm run test:live",
    "clean": "node scripts/clean.mjs",
    "state": "tsx scripts/state.ts",
    "sandbox:build": "docker build -t sophia-sandbox:5 resources/sandbox",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build",
    "docs:preview": "npm --prefix website run preview",
    "doctor": "tsx scripts/doctor.ts",
    "test:sandbox": "vitest run -c vitest.live.config.ts tests/live/sandbox.live.test.ts",
    "docs:check": "node website/scripts/check-links.mjs"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "ai",
    "ai-agent",
    "openrouter",
    "llm",
    "moderation",
    "typescript"
  ],
  "author": "Pedro Silva",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "description": "A Discord assistant with durable tasks, scoped memory, research tools, an isolated workspace and explicit action permissions.",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@libsql/client": "^0.17.2",
    "discord.js": "^14.26.2",
    "gpt-tokenizer": "^3.4.0",
    "linkedom": "^0.18.13",
    "openai": "^6.34.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
