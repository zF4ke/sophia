{
  "name": "sophia",
  "version": "5.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch \"src/**/*\" --watch \"resources/**/*\" --ext ts,js,json,md --exec \"tsx src/index.ts\"",
    "start": "tsx ./src/index.ts",
    "check": "npm run typecheck && npm run test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:live": "vitest run -c vitest.live.config.ts",
    "test:all": "npm run test && npm run test:live",
    "clean": "node -e \"const fs=require('fs');const p=require('path');const dirs=['storage/runtime','storage/memory','storage/test-memory','storage/test-runtime-store','storage/logs','storage/security'];dirs.forEach(d=>{const full=p.resolve(d);try{if(fs.existsSync(full)){fs.rmSync(full,{recursive:true,force:true});fs.mkdirSync(full,{recursive:true});console.log('Cleaned '+d)}}catch(e){console.log('SKIP '+d+': '+e.code)}});const settings=p.resolve('storage/settings.json');try{if(fs.existsSync(settings)){fs.unlinkSync(settings);console.log('Removed settings.json')}}catch(e){console.log('SKIP settings.json: '+e.code)}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "",
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.1",
    "openai": "^6.34.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  }
}
